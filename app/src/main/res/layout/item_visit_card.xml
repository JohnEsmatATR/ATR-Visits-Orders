<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:layoutDirection="rtl"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Orange side strip (indicator bar) -->
        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:background="@color/colorAccent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top row: name + status chip + action icons -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_pharmacy_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:textColor="@color/gray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="صيدلية مجدى حبيب" />

                <LinearLayout
                    android:id="@+id/ll_action_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_delete"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_red_light"
                        android:padding="6dp"
                        android:src="@drawable/ic_trash"
                        app:tint="@color/red"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/iv_swap"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_circle_blue_light"
                        android:padding="6dp"
                        android:src="@drawable/ic_swap"
                        app:tint="@color/blue"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_chip_orange_light"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="@string/status_unapproved"
                        android:textColor="@color/colorAccent"
                        android:textSize="11sp"
                        app:drawableStartCompat="@drawable/ic_dot_orange" />
                    <!-- swap to @string/status_approved + @color/green + green dot when approved -->
                </LinearLayout>

            </RelativeLayout>

            <!-- Code + location row -->
            <TextView
                android:id="@+id/tv_code_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_gravity="right"
                android:textColor="@color/grey_color"
                android:textSize="12sp"
                tools:text="كود: 10121 • موقع: 3698456" />
            <!-- build with: getString(R.string.code) + ": " + code + " • " + getString(R.string.location_code_label) + ": " + locationCode -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/input_box_stroke" />

            <!-- Delegate row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_delegate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:textSize="13sp"
                    tools:text="المندوب: مارى ماهر اديب خليل" />
                <!-- build with: getString(R.string.delegate_prefix) + " " + delegateName -->

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/ic_person_outline_black_24dp"
                    app:tint="@color/grey_color"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <!-- Address row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical|right"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:textSize="13sp"
                    tools:text="شارع وابور الترجمان   بولاق   مصر" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="6dp"
                    android:src="@drawable/ic_address"
                    app:tint="@color/grey_color"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>