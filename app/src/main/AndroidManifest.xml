<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.akhnaton.foodvisits">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.SET_TIME_ZONE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />

    <uses-feature android:name="android.hardware.location.gps" />

    <application
        android:name=".shared.SharedPreferencesHelper"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_blank"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_blank_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodVisits"
        android:usesCleartextTraffic="true"
        tools:replace="android:icon"
        tools:targetApi="31">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.akhnaton.foodvisits.ui.home.visits.orderHistory.OrderHistoryDetailsActivity"
            android:exported="false" />

        <activity
            android:name="com.akhnaton.foodvisits.ui.home.visits.orderHistory.OrdersHistoryActivity"
            android:exported="true" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.addCustomer.AddCustomerActivity"
            android:exported="true" />

        <activity
            android:name="com.akhnaton.foodvisits.ui.home.visits.order.ReturnActivity"
            android:exported="false" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.visits.order.OrderActivity"
            android:exported="false" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.visits.paymentType.PaymentActivity"
            android:exported="true" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.phoneVisit.PhoneVisitsDetailsActivity"
            android:exported="true" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.visits.VisitsDetailsActivity"
            android:exported="true" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.profile.SetupProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.printFood.FoodInvoiceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true" />
        <activity
            android:name="com.akhnaton.foodvisits.ui.home.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.WebOrderActivity"
            android:exported="false" />

        <service
            android:name=".shared.location.GetLocationService"
            android:enabled="true" />
    </application>

</manifest>