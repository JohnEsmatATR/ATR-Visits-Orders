<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_route_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFDFB"
    app:strokeColor="#FFD8BE"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- علامة الصح في أقصى اليسار -->
        <ImageView
            android:id="@+id/iv_route_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_check_white"
            android:background="@drawable/bg_circle_green"
            android:padding="4dp"
            android:visibility="visible"
            tools:ignore="ContentDescription" />

        <!-- الأيقونة البرتقالية الدائرية في أقصى اليمين -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iv_route_icon_bg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#FF8A3D"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/iv_route_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_swap"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <!-- النصوص في المنتصف بجانب الأيقونة البرتقالية -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/iv_route_icon_bg"
            android:layout_toRightOf="@id/iv_route_check"
            android:layout_centerVertical="true"
            android:layout_marginRight="12dp"
            android:gravity="right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_route_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="@string/route_name_sample" />

            <TextView
                android:id="@+id/tv_route_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#888888"
                android:textSize="13sp"
                tools:text="@string/route_code_sample" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>