<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.SET_TIME_ZONE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />

    <uses-feature android:name="android.hardware.location.gps" />

    <uses-permission android:name="android.permission.BLUETOOTH" />

    <application
        android:name=".shared.SharedPreferencesHelper"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodVisits"
        android:usesCleartextTraffic="true"
        tools:replace="android:icon"
        tools:targetApi="31">
        <service
            android:name=".shared.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <activity
            android:name=".ui.home.customerCoding.CustomerCodingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.home.supervisor.creditLimit.CreditLimitFormActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.supervisor.superOrderDetails.SuperOrderDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.supervisor.superShowOrders.SuperShowOrdersActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home.visits.promoters.promoterCompetitorsActivity.PromoterCompetitorsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.visits.promoters.promoterDayDetails.PromoterDayDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.visits.promoters.promotersUploadImages.PromotersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.visits.promoters.promotersItems.PromoterItemsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.home.visits.orderHistory.OrderHistoryDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.visits.orderHistory.OrdersHistoryActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home.addCustomer.AddCustomerActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home.visits.order.ReturnActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.visits.order.OrderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.visits.paymentType.PaymentActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home.phoneVisit.PhoneVisitsDetailsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.home.visits.VisitsDetailsActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home.profile.SetupProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.printFood.FoodInvoiceActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true" />
        <activity
            android:name=".ui.home.profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.home.WebOrderActivity"
            android:exported="false" />

        <service
            android:name=".shared.location.GetLocationService"
            android:enabled="true"
            android:foregroundServiceType="location" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>