<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_visit_plan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@color/background"
    tools:context=".ui.home.visitPlan.VisitPlanFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ===================== Header banner ===================== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingTop="@dimen/_16sdp"
                android:paddingBottom="@dimen/_8sdp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBackContainer"
                    android:layout_width="@dimen/_32sdp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_16sdp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivBack"
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_left"
                        app:tint="@color/colorPrimary" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/ll_header_texts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- العنوان الأول (يظهر على اليمين في RTL) -->
                        <TextView
                            android:id="@+id/tv_header_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/visit_plan_title"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_16ssp"
                            android:textStyle="bold" />

                        <!-- أيقونة الكالندر تانية (تظهر على الشمال في RTL) -->
                        <FrameLayout
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:layout_marginLeft="@dimen/_8sdp">

                            <View
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_6sdp"
                                android:layout_gravity="top"
                                android:background="@color/color_one" />

                            <TextView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="bottom"
                                android:background="@color/color_white"
                                android:gravity="center"
                                android:text="17"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_9ssp"
                                android:textStyle="bold" />
                        </FrameLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_header_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:drawablePadding="@dimen/_4sdp"
                        android:gravity="center_horizontal"
                        android:text="@string/visit_plan_subtitle"
                        android:textColor="@color/grey_color"
                        android:textSize="@dimen/_10ssp" />

                </LinearLayout>

            </RelativeLayout>

            <!-- ===================== Calendar card ===================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Month row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_month_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:text="سبتمبر ٢٠٢٦"
                            android:textColor="@color/gray"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                        <!-- ^ set this programmatically from the current month/year -->

                        <LinearLayout
                            android:id="@+id/ll_period_nav"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_next_period"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="4dp"
                                android:padding="3dp"
                                android:src="@drawable/ic_arrow_left"
                                android:visibility="gone"
                                app:tint="@color/gray"
                                tools:ignore="ContentDescription" />

                            <LinearLayout
                                android:id="@+id/chip_weekly_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_orange_light"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp">

                                <ImageView
                                    android:id="@+id/iv_chip_icon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_arrow_up"
                                    app:tint="@color/colorAccent"
                                    tools:ignore="ContentDescription" />

                                <TextView
                                    android:id="@+id/tv_chip_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="6dp"
                                    android:text="@string/weekly_view"
                                    android:textColor="@color/colorAccent"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/iv_prev_period"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="4dp"
                                android:padding="3dp"
                                android:scaleX="-1"
                                android:src="@drawable/ic_arrow_left"
                                android:visibility="gone"
                                app:tint="@color/gray"
                                tools:ignore="ContentDescription" />

                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Weekday headers: rightmost = Sunday, leftmost = Saturday -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_sun_short" />
                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_mon_short" />
                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_tue_short" />
                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_wed_short" />
                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_thu_short" />
                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_fri_short" />
                        <TextView style="@style/CalendarWeekDayLabel" android:text="@string/weekday_sat_short" />
                    </LinearLayout>

                    <!-- Calendar grid (6 weeks x 7 days) -->
                    <GridLayout
                        android:id="@+id/grid_calendar_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:columnCount="7"
                        android:rowCount="6">
                        <!-- Fill from code using item_calendar_day.xml per cell.
                             IMPORTANT: since this is now a plain LTR-style grid (no start/end
                             tricks), place Sunday in column 0 (rightmost visually only if you
                             also set android:layoutDirection="rtl" on this GridLayout, OR simply
                             feed the adapter columns in already-mirrored order: column 0 = Sat,
                             column 6 = Sun, to match the header row above without relying on
                             mirroring at all. -->
                    </GridLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===================== Search bar ===================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/input_box_bg"
                app:strokeColor="@color/input_box_stroke"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentRight="true"
                        android:src="@drawable/ic_search"
                        app:tint="@color/gray"
                        tools:ignore="ContentDescription" />

                    <View
                        android:id="@+id/et_search_dummy_anchor"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:layout_alignParentRight="true" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="16dp"
                        android:layout_toLeftOf="@id/et_search_dummy_anchor"
                        android:layout_alignParentLeft="true"
                        android:background="@null"
                        android:gravity="right"
                        android:hint="@string/search_visits_today_hint"
                        android:inputType="text"
                        android:textColorHint="@color/grey2"
                        android:textSize="14sp" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===================== Visits count + date ===================== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_visit_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:text="الجمعة، ١٨ سبتمبر"
                    android:textColor="@color/gray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
                <!-- ^ set from code (selected date), no fixed string needed -->

                <TextView
                    android:id="@+id/tv_visit_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:background="@drawable/bg_chip_orange_light"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/visits_count_format"
                    android:textColor="@color/colorAccent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="13 زيارة" />
                <!-- set with getString(R.string.visits_count_format, count) -->
            </RelativeLayout>

<!--            &lt;!&ndash; ===================== Visits list ===================== &ndash;&gt;-->
<!--            <androidx.recyclerview.widget.RecyclerView-->
<!--                android:id="@+id/rv_visits"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginHorizontal="16dp"-->
<!--                android:nestedScrollingEnabled="false"-->
<!--                tools:listitem="@layout/item_visit_card"-->
<!--                tools:itemCount="3" />-->

            <!-- ===================== Visits list (Static - Design only) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <!-- ============ كارت 1 ============ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:layoutDirection="rtl"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:layout_alignParentRight="true"
                            android:background="@color/colorAccent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:text="صيدلية مجدى حبيب"
                                    android:textColor="@color/gray"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_centerVertical="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_circle_red_light"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_trash"
                                        app:tint="@color/red" />

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_marginLeft="8dp"
                                        android:background="@drawable/bg_circle_blue_light"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_swap"
                                        app:tint="@color/blue" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="8dp"
                                        android:background="@drawable/bg_chip_orange_light"
                                        android:drawablePadding="4dp"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="5dp"
                                        android:text="@string/status_unapproved"
                                        android:textColor="@color/colorAccent"
                                        android:textSize="11sp"
                                        app:drawableStartCompat="@drawable/ic_dot_orange" />
                                </LinearLayout>
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:layout_gravity="right"
                                android:text="كود: 10121 • موقع: 3698456"
                                android:textColor="@color/grey_color"
                                android:textSize="12sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="10dp"
                                android:background="@color/input_box_stroke" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical|right"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="المندوب: مارى ماهر اديب خليل"
                                    android:textColor="@color/gray"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/ic_person_outline_black_24dp"
                                    app:tint="@color/grey_color" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical|right"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="شارع وابور الترجمان بولاق مصر"
                                    android:textColor="@color/gray"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/ic_address"
                                    app:tint="@color/grey_color" />
                            </LinearLayout>

                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- ============ كارت 2 ============ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:layoutDirection="rtl"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="match_parent"
                            android:layout_alignParentRight="true"
                            android:background="@color/green" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentRight="true"
                                    android:text="صيدلية النور"
                                    android:textColor="@color/gray"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentLeft="true"
                                    android:layout_centerVertical="true"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:background="@drawable/bg_circle_red_light"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_trash"
                                        app:tint="@color/red" />

                                    <ImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_marginLeft="8dp"
                                        android:background="@drawable/bg_circle_blue_light"
                                        android:padding="6dp"
                                        android:src="@drawable/ic_swap"
                                        app:tint="@color/blue" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="8dp"
                                        android:background="@drawable/bg_chip_orange_light"
                                        android:drawablePadding="4dp"
                                        android:paddingHorizontal="10dp"
                                        android:paddingVertical="5dp"
                                        android:text="معتمدة"
                                        android:textColor="@color/colorAccent"
                                        android:textSize="11sp"
                                        app:drawableStartCompat="@drawable/ic_dot_orange" />
                                </LinearLayout>
                            </RelativeLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:layout_gravity="right"
                                android:text="كود: 10245 • موقع: 3698777"
                                android:textColor="@color/grey_color"
                                android:textSize="12sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="10dp"
                                android:background="@color/input_box_stroke" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical|right"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="المندوب: أحمد سمير فتحي"
                                    android:textColor="@color/gray"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/ic_person_outline_black_24dp"
                                    app:tint="@color/grey_color" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical|right"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="شارع الجمهورية المنصورة"
                                    android:textColor="@color/gray"
                                    android:textSize="13sp" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginLeft="6dp"
                                    android:src="@drawable/ic_address"
                                    app:tint="@color/grey_color" />
                            </LinearLayout>

                        </LinearLayout>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===================== Floating action buttons (bottom-LEFT, per mockup) ===================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_duplicate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="100dp"
        android:backgroundTint="@color/fab_duplicate_blue"
        android:src="@drawable/ic_copy"
        app:tint="@color/white"
        app:fabSize="normal"
        tools:ignore="ContentDescription" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_visit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/colorAccent"
        android:src="@drawable/ic_baseline_add_24"
        app:tint="@color/white"
        app:fabSize="normal"
        tools:ignore="ContentDescription" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>