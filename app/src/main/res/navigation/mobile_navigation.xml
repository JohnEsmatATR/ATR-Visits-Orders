<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.akhnaton.foodvisits.ui.home.main.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/toHome"
            app:destination="@id/mainFragment" />
        <action
            android:id="@+id/action_mainFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/foodFragment"
        android:name="com.akhnaton.foodvisits.ui.home.printFood.FoodFragment"
        android:label="fragment_food"
        tools:layout="@layout/fragment_food" />

    <fragment
        android:id="@+id/visitsFragment"
        android:name="com.akhnaton.foodvisits.ui.home.visits.VisitsFragment"
        android:label="fragment_visits"
        tools:layout="@layout/fragment_phone_visits" />

    <fragment
        android:id="@+id/ticketsFragment"
        android:name="com.akhnaton.foodvisits.ui.home.tickets.TicketsFragment"
        android:label="fragment_tickets"
        tools:layout="@layout/fragment_tickets" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.akhnaton.foodvisits.ui.home.profile.ProfileActivity"
        android:label="fragment_profile"
        tools:layout="@layout/activity_profile" />

    <fragment
        android:id="@+id/visitPhoneFragment"
        android:name="com.akhnaton.foodvisits.ui.home.phoneVisit.PhoneVisitsFragment"
        android:label="fragment_visit_phone"
        tools:layout="@layout/fragment_phone_visits" />
</navigation>